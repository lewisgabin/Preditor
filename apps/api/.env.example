APP_NAME=QuinielaLab
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Santo_Domingo
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_DO
APP_VERSION=local
GIT_SHA=local

FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_DOMAIN=localhost
SANCTUM_STATEFUL_DOMAINS=localhost:5173

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=quinielalab
DB_USERNAME=quinielalab
DB_PASSWORD=change_me_local_only

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

LOTTERY_API_ENABLED=false
LOTTERY_API_PROVIDER=fake
LOTTERY_API_BASE_URL=
LOTTERY_API_ENDPOINT_TEMPLATE=
LOTTERY_API_KEY=
LOTTERY_API_TIMEOUT_SECONDS=10
LOTTERY_API_CONNECT_TIMEOUT_SECONDS=5
LOTTERY_API_RETRY_ATTEMPTS=3
LOTTERY_API_RETRY_BACKOFF_SECONDS=5
LOTTERY_API_LOOKBACK_DAYS=1
LOTTERY_API_RECONCILIATION_DAYS=3

LOTTERY_SYNC_AUTOMATIC_ENABLED=false
LOTTERY_SYNC_PROVIDER=elboletoganador
LOTTERY_SYNC_INTERVAL_MINUTES=10
LOTTERY_SYNC_STALE_AFTER_MINUTES=20
LOTTERY_SYNC_FINAL_RECHECK_ENABLED=true
LOTTERY_SYNC_FINAL_RECHECK_TIME=23:45
LOTTERY_SYNC_STATUS_REFRESH_SECONDS=30

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.test
MAIL_FROM_NAME="${APP_NAME}"
